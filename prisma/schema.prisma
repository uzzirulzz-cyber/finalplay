// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  password  String // hashed
  name      String
  role      String   @default("admin") // admin | staff
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id            String   @id @default(cuid()) @map("_id")
  email         String   @unique
  password      String   // hashed
  name          String
  phone         String?
  country       String?
  address       String?
  avatar        String?
  role          String   @default("customer") // customer | vip
  emailVerified Boolean  @default(false)
  verifyToken   String?
  verifyExpires DateTime?
  resetToken    String?
  resetExpires  DateTime?
  referralCode  String?
  referredBy    String?
  orders        Int      @default(0)
  totalSpent    Float    @default(0)
  wishlist      String[] @default([]) // product IDs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("customers")
}

model Product {
  id                String   @id @default(cuid()) @map("_id")
  sku               String   @unique
  name              String
  description       String?
  category          String?
  price             Float    // USD base price (selling price)
  currency          String   @default("USD")
  originalPrice     Float?   // original price (for discount display)
  originalCurrency  String?
  compareAtPrice    Float?   // strikethrough price
  region            String?
  brand             String?
  manufacturer      String?
  stock             Int      @default(0)
  status            String   @default("active") // active | draft | archived
  image             String?  // primary image URL
  images            String[] @default([]) // gallery of image URLs
  digital           Boolean  @default(true)
  deliveryMethod    String   @default("instant") // instant | shipping | manual
  tags              String[]
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  salesCount        Int      @default(0)
  featured          Boolean  @default(false)
  trending          Boolean  @default(false)
  bestSeller        Boolean  @default(false)
  flashDeal         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([featured])
  @@index([trending])
  @@map("products")
}

model Order {
  id             String     @id @default(cuid()) @map("_id")
  orderNumber    String     @unique
  customerId     String?
  customerName   String
  customerEmail  String?
  items          OrderItem[]
  total          Float
  currency       String     @default("USD")
  status         String     @default("pending") // pending | processing | completed | cancelled
  paymentStatus  String     @default("pending") // pending | paid | refunded
  paymentMethod  String?
  deliveryStatus String     @default("pending") // pending | delivered | shipped
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@map("orders")
}

type OrderItem {
  productId String
  name      String
  price     Float
  qty       Int
  image     String?
  digital   Boolean
  deliveryMethod String?
  licenseKey String? // for digital products
}

model DigitalLicense {
  id          String   @id @default(cuid()) @map("_id")
  customerId  String
  orderId     String?
  productId   String
  productName String
  licenseKey  String
  activationInfo String?
  status      String   @default("active") // active | expired | revoked
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([productId])
  @@map("digital_licenses")
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  customerId String
  type      String   // order | payment | delivery | system | promo
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([read])
  @@map("notifications")
}

model Review {
  id        String   @id @default(cuid()) @map("_id")
  productId String
  customerId String?
  customerName String
  rating    Int      // 1-5
  title     String?
  comment   String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("reviews")
}

model Setting {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ActivityLog {
  id        String   @id @default(cuid()) @map("_id")
  action    String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
